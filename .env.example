# Copy to `.env` and fill in values to run integration tests without
# exporting env vars on every shell. Shell-exported vars override these.

PICSURE_INTEGRATION=1
PICSURE_TEST_PLATFORM=BDC_PREDEV_AUTHORIZED
PICSURE_TEST_TOKEN=

# Concept path used by query and export live tests. Must exist on the
# target deployment — this one works on BDC_DEV_OPEN / BDC_PREDEV_*.
# For a different platform, pick a path returned by a dictionary search
# (e.g. via `session.search("age")`).
PICSURE_TEST_CONCEPT_PATH=\open_access-1000Genomes\SIMULATED AGE\

# Search term used by search live tests. "age" works on most PIC-SURE
# deployments. Override if your target dataset uses different terms.
PICSURE_TEST_SEARCH_TERM=age

# Gene symbol used by the genomic live tests (test_query_genomic_live.py).
# Required — without it all four genomic tests skip, so the suite passes
# while contributing no genomic coverage.
#
# CHD8 is verified on BDC_PREDEV_AUTHORIZED. It should hold on the other
# BDC authorized deployments (BDC_AUTHORIZED, BDC_DEV_AUTHORIZED), which
# serve the same variant data; a non-BDC target such as NHANES_AUTHORIZED
# needs a symbol from that deployment's own variant data.
#
# Genomic tests need a platform with genomic support, which is the
# *_AUTHORIZED members — the *_OPEN members do not carry variant data.
# Even with the gene set, only the two count-based tests pass on predev:
# variant_count and variant_list still skip because that deployment does
# not serve the variant-centric result types.
PICSURE_TEST_GENE=CHD8

# TLS verification for the transport. Set to false only when pointing
# PICSURE_TEST_PLATFORM at a local stack with a self-signed certificate;
# leave it unset against any real deployment.
# PICSURE_SSL_VERIFY=false
